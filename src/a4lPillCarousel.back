bool registerDevice(){

  if(WiFi.status() != WL_CONNECTED) return false;

  JsonDocument doc;

  // Add root level properties
  doc["message_type"] = "insert_update_device";
  doc["device_type"] = deviceInfo.type;
  doc["position"] = deviceInfo.position;
  doc["friendly_name"] = "Smart Pillbox";
  doc["type_short"] = deviceInfo.type_short;
  doc["device_id"] = uid;
  doc["client_id"] = customVar.clientId;
  doc["version"] = deviceInfo.version;
  doc["ip_address"] = WiFi.localIP().toString(); // Get IP address as String
  doc["device_processor"] = deviceInfo.processor;

  // Create the "json_config" object
  JsonObject jsonConfig = doc["json_config"].to<JsonObject>();

  // Create the "times" array within "json_config"
  JsonArray timesArray = jsonConfig["times"].to<JsonArray>();

  // Add time objects to the "times" array
  const char* times[] = {"08:00", "12:00", "16:00", "20:00"};
  for (size_t i = 0; i < 4; ++i) {
    JsonObject timeObj = timesArray.add<JsonObject>();
    timeObj["time"] = times[i];
    timeObj["active"] = true; 
  }

  // Add the "offset" property to "json_config"
  jsonConfig["offset"] = 0;

  // Create the "json_settings" array within the root 
  JsonArray settingsArray = doc["json_settings"].to<JsonArray>();
  for (size_t i = 0; i < 7; ++i) {
    JsonArray innerArray = settingsArray.add<JsonArray>();
    for (size_t j = 0; j < 4; ++j) {
      innerArray.add(false);
    }
  }

  // Serialize the JSON document to a String
  String jsonString;
  serializeJson(doc, jsonString);

  Serial.println(jsonString);
  // Send the JSON to your backend (use your preferred method: HTTP POST, MQTT, etc.)
  String response = sendToBackend(jsonString);
  // Parse the JSON response
  DeserializationError error = deserializeJson(doc, response);

  // Check for parsing errors
  if (error) {
      Serial.print("JSON Parsing failed: ");
      Serial.println(error.c_str());
      return false;
  }

  // Extract values
  bool success = doc["success"];  // Read success flag
  const char* action = doc["action"];  // Read action value

  // Output the results
  Serial.print("Success: ");
  Serial.println(success ? "Yes" : "No");
  
  Serial.print("Action: ");
  Serial.println(action);
  return true;
}

String sendToBackend(const String &data) {

HTTPClient http;

  http.begin("http://apps4leisure.com/smart_home/smart_home_endpoint.php");  // URL passed as an argument
  http.addHeader("Content-Type", "application/json");
  int httpResponseCode = http.POST(data);
  String responseData = "";
  // If the request was successful, read the response
  if (httpResponseCode > 0) {
    responseData = http.getString();  // Get the response body
    Serial.printf("HTTP Response code: %d\n", httpResponseCode);
    Serial.println("Response: " + responseData);  // Print the response data
  } else {
    Serial.printf("Error on sending %s: %s\n",  http.errorToString(httpResponseCode).c_str());
  }

  http.end();
  
  return responseData;  // Re

}

void buildMainDisplay(){
  display.init(115200, true, 2, false); 
  display.setRotation(4);               // Set the rotation (0, 1, 2, or 3) depending on your display
  display.fillScreen(GxEPD_WHITE);      // Fill the screen with white background
  display.setTextColor(GxEPD_BLACK);    // Set the text color to black

  display.setFont(&FreeSansBold12pt7b);
  printCentre("Smart Pill Box", 17);
  display.setFont(&FreeSansBold9pt7b);
  printCentre("apps4leisure", 36);
  display.drawBitmap(156, 26, copyright_12, 12, 12, GxEPD_BLACK);
  drawMatrix();
  display.display();
}

void setup_message(){
  display.init(115200, true, 2, false); 
  display.setRotation(4);               // Set the rotation (0, 1, 2, or 3) depending on your display
  display.fillScreen(GxEPD_WHITE);      // Fill the screen with white background
  display.setTextColor(GxEPD_BLACK);    // Set the text color to black
  display.setFont(&FreeSansBold12pt7b);
  printCentre("Please setup",80);
  printCentre("your pillbox",105);
  printCentre("using the",130);
  printCentre("companion app",155);
  display.display();
}

void partialMatrixRefresh(){
  display.firstPage();
  do{
    display.setPartialWindow(0, 65, display.width(), 185);
    drawMatrix();
  } while (display.nextPage());
  display.firstPage();
}

void scanSwitchMatrix(){

  for (int periodCount = 0; periodCount < 4; periodCount++){
    //for (int z = 0; z < 4; z++){
    //    pinMode(periodPort[z], INPUT);   
    //}
    pinMode(periodPort[periodCount], OUTPUT);  
    digitalWrite(periodPort[periodCount], HIGH);
    delay(10);
    for (int day = 0; day < 7; day++){
      if (digitalRead(dayPort[day]) == false){
        if (customVar.pillMatrix[periodCount][day] == false){
          matrixChanged = true;
          customVar.pillMatrix[periodCount][day] = true;
        }
      }
    }
    digitalWrite(periodPort[periodCount], LOW);
 
    delay(10);
  }
  if (matrixChanged){
    matrixChanged = false;
    Serial.println("Saved");
    EEPROM.put(0, customVar);
    EEPROM.commit();
    // Perform partial screen refresh
    display.firstPage();
    do{
      display.setPartialWindow(0, 65, display.width(), 185);
      drawMatrix();
    } while (display.nextPage());
    display.firstPage();
    //Update php endpoint
    
    if(WiFi.status() == WL_CONNECTED) sendPillMatrix(customVar.pillMatrix);
    delay(100);
  }
}

void drawMatrix(){
  // Draw the days of week at the top and highlight the current day
  int currentDay = 1;//timeFunctions.getWeekDay();
  display.setFont(&FreeMonoBold10pt7b);
  display.setCursor(4, frameStartY - 5);
  display.setTextColor(GxEPD_BLACK);
  for (int i = 0; i < 7; i++){
    if (i == currentDay){
      for (int j = 0; j < 2; j++){
        display.drawRect(1 + (28 * i) + j, frameStartY - 19 + j, 29 - 2 * j, 18 - 2 * j, GxEPD_BLACK);
      }
    }
    display.print(daysOfWeek[i]);
    display.setCursor(display.getCursorX() + 4, display.getCursorY()); // Add a small gap
  }
  // Define matrix parameters
  // Draw the matrix area as a black frame to be filled
  display.fillRect(0, frameStartY, frameWidth, frameHeight, GxEPD_BLACK);
  // Calculate the top-left corner position to center the matrix in the bottom section
  int startX = (display.width() - matrixWidth) / 2;
  int startY = frameStartY + gap;
  // Draw the 7x4 matrix of boxes with a black gap and white fill
  for (int period = 0; period < 4; period++){
    for (int day = 0; day < 7; day++){
      display.fillRect(startX + (day * totalBoxSize), startY + (period * totalBoxSize), boxSize, boxSize, GxEPD_WHITE); // Draw the white fill
      display.drawRect(startX + (day * totalBoxSize), startY + (period * totalBoxSize), boxSize, boxSize, GxEPD_BLACK); // Draw the black gap (thick line)
      if (!customVar.activePeriod[period]){
        drawBitmap(not_used_24, 24, day, period);
      }else{
        if (customVar.pillMatrix[period][day])
          drawBitmap(tick_24, 24, day, period);
      }
    }
  }
  //display.setCursor(4, 192);
  double actualVoltage = ReadVoltage(analogRead(BATTRIE_DATA_GPIO)) * 2.07; 
  int actualePercent = calcPercentage(actualVoltage, 3.00, 3.7);
  if (actualePercent > 100 ) actualePercent = 100;
  printCentre("Battery: " + String(readBatteryPower()) + "%", 195);
}

void drawBitmap(const uint8_t *imageData, int size, int day, int period){
  // Draw the star shape using the bitmap data
  int offsetX = (size == 24) ? 3 : 7;
  int offsetY = (size == 24) ? 67 : 71;
  for (int i = 0; i < size; i++){
    for (int j = 0; j < size; j++){
      uint8_t pixelData = pgm_read_byte(&imageData[i * (size / 8) + (j / 8)]);
      uint8_t pixelBit = (pixelData >> (7 - j % 8)) & 0x01;
      if (pixelBit == 1){                                                                                        // 119
        display.drawPixel(offsetX + (28 * day) + j, offsetY + (28 * period) + i, GxEPD_BLACK); // Set the pixel to black
      }
    }
  }
}

void printCentre(String text, int y){
  int16_t tbx, tby;
  uint16_t tbw, tbh;
  display.getTextBounds(text, 0, 0, &tbx, &tby, &tbw, &tbh);
  // center the bounding box by transposition of the origin:
  int x = ((display.width() - tbw) / 2) - tbx;
  display.setCursor(x, y);
  display.print(text);
}

void resetMatrixClick(){
  Serial.println("Reset pressed");
  for (int p = 0; p < 4; p++){
    for (int d = 0; d < 7; d++){
      if (customVar.activePeriod[p]){
        customVar.pillMatrix[p][d] = false;
      }
    }
  }
  matrixChanged = true;
}

void resetWifiClick(){
  customVar.callWifiManager = true;
  EEPROM.put(0, customVar);
  EEPROM.commit();
  ESP.restart();
}

void initMatrixPorts(){
  for (int x = 0; x < 7; x++){
    if (x < 4) pinMode(periodPort[x], OUTPUT);
    pinMode(dayPort[x], INPUT);
  }
}

void setSleep(){
  //return;
  // delay befor sleep to alow data to be sent
  delay(500);

  display.hibernate();
  delay(1000);
  esp_sleep_enable_timer_wakeup(1000ULL * MILLS_HOUR);
  esp_sleep_enable_ext0_wakeup(GPIO_NUM_33, 1);
  Serial.println("Going to sleep");
  delay(MILLS_SECS * 3);
  esp_deep_sleep_start();
}

const char* boolToString(bool b) {
  return b ? "true" : "false";
}

void get_times_settings(){

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("No wifi connection!");
    return;
  }
  // Create a JSON document
  JsonDocument doc;
  // Add data to the JSON document
  doc["message_type"] = "get_device";
  doc["device_id"] = uid;
  String jsonString;
  serializeJson(doc, jsonString);
  
  // Send the JSON string to the backend
  // Sending a POST request and getting the response
  String response = sendToBackend(jsonString);

  // Use the response in your program
  if (response.length() > 0) {
    Serial.println("Backend Response: " + response);
  } else {
    Serial.println("Failed to get a response from the backend.");
  }
  
  Serial.println(response);
  // Extract the times_data array
  // Parse the JSON data to get the json_config
  DeserializationError error = deserializeJson(doc, response);
  const char* jsonConfigString = doc["device"]["json_config"];
  error = deserializeJson(doc, jsonConfigString);
  //Now read the times data to setup the display
  Serial.println(jsonConfigString);
  JsonArray timesData = doc["times"];
  // Iterate over the array and populate the customVar structure
  for (int i = 0; i < timesData.size() && i < 4; i++) {
    JsonObject obj = timesData[i];
    const char* time = obj["time"];
    bool active = obj["active"];
    strncpy(customVar.times[i], time, sizeof(customVar.times[i]) - 1);
    customVar.times[i][sizeof(customVar.times[i]) - 1] = '\0'; // Ensure null termination
    customVar.activePeriod[i] = active;
  }
}

// Function to convert pillMatrix to JSON and send it to backend
void sendPillMatrix(bool pillMatrix[4][7]) {
  // Create a JSON document
  JsonDocument doc;
 
  // Add data to the JSON document
  doc["message_type"] = "insert_update_device";
  doc["device_id"] = uid;
  //JsonObject data = doc["data"].to<JsonObject>();
  doc["battery_level"] = readBatteryPower();

  JsonDocument tempDoc;
  JsonArray array = tempDoc.to<JsonArray>(); // Create the nested array structure

  for (int i = 0; i < 7; i++) {
      JsonArray nested = array.add<JsonArray>(); // Create inner arrays
      for (int j = 0; j < 4; j++) {
          nested.add(customVar.pillMatrix[j][i]); // Add boolean values
      }
  }
  
  doc["json_settings"] = array;

  String jsonString;
  serializeJson(doc, jsonString);
  Serial.println(jsonString);

  // Send the JSON string to the backend
  if (WiFi.status() == WL_CONNECTED) {
    sendToBackend(jsonString);
  }else {
    Serial.println("WiFi Disconnected");
  }
}

double ReadVoltage(double reading) {
  //double reading = analogRead(sensorPin); // Reference voltage is 3v3 so maximum reading is 3v3 = 4095 in range 0 to 4095
  if (reading < 1 || reading > 4095) return 0;
  // return -0.000000000009824 * pow(reading,3) + 0.000000016557283 * pow(reading,2) + 0.000854596860691 * reading + 0.065440348345433;
  return -0.000000000000016 * pow(reading, 4) + 0.000000000118171 * pow(reading, 3) - 0.000000301211691 * pow(reading, 2) + 0.001109019271794 * reading + 0.034143524634089;
} 

int calcPercentage(float actual, float min, float max){
  //Serial.print("min:");
  //Serial.println(min);
  // Serial.print("max:");
  //Serial.println(max);
  int result = (actual - min) / (max - min) * 100;
  if (result < 0) result = 0;
  if (result > 100) result = 100;
  return result;
}

void scanSwitchMatrixTest(){
  Serial.println("         SUN  MON  TUE  WED  THU  FRI  SAT");
  for (int periodCount = 0; periodCount < 4; periodCount++){
    pinMode(periodPort[periodCount], OUTPUT);
    digitalWrite(periodPort[periodCount], HIGH);
    if (periodCount == 0)
      Serial.print(" AM       ");
    if (periodCount == 1)
      Serial.print(" NOON     ");
    if (periodCount == 2)
      Serial.print(" TEA      ");
    if (periodCount == 3)
      Serial.print(" BED      ");
    for (int i = 0; i < 7; i++){
      Serial.print(digitalRead(dayPort[i]));
      Serial.print("    ");
    }
    digitalWrite(periodPort[periodCount], LOW);
    Serial.println("");
   
  }
}

