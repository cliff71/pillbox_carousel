void handleJson(const String& jsonPayload) {
  Serial.println("Callback triggered with JSON payload:");
  Serial.println(jsonPayload);
  JsonDocument doc;
  DeserializationError error = deserializeJson(doc, jsonPayload);

  if (error) {
      Serial.print("deserializeJson() failed: ");
      Serial.println(error.c_str());
      return; // Exit if deserialization failed
  }

  // Check and copy each key only if it exists
  if (!doc["wifi_ssid"].isNull()) {
      const char* tmpChar = doc["wifi_ssid"];
      strcpy(customVar.ssid, tmpChar);
      Serial.println(tmpChar);
  } else {
      Serial.println("Key 'wifi_ssid' is missing!");
  }

  if (!doc["wifi_password"].isNull()) {
      const char* tmpChar = doc["wifi_password"];
      strcpy(customVar.password, tmpChar);
      Serial.println(tmpChar);
  } else {
      Serial.println("Key 'wifi_password' is missing!");
  }

  if (!doc["clientId"].isNull()) {
      const char* tmpChar = doc["clientId"];
      customVar.clientId = atol(tmpChar);
      Serial.println(tmpChar);
  } else {
      Serial.println("Key 'clientId' is missing!");
  }

  customVar.callWifiManager = false;
  EEPROM.put(0, customVar);
  EEPROM.commit();
  Serial.println("Config saved");

  currentState = ADD_DEVICE;

}

AccelStepper stepper(AccelStepper::HALF4WIRE, 4, 17, 16, 13);
//AccelStepper stepper(AccelStepper::FULL4WIRE, 16, 4, 17, 13);
const int stepsPerSegment = 137;
#define HOME_GPIO 36
bool homeState = false;

void setup(){

  WRITE_PERI_REG(RTC_CNTL_BROWN_OUT_REG, 0); // disable brownout detector

  Serial.begin(115200);

  delay(500);

  EEPROM.begin(512);
  EEPROM.get(0, customVar);
  //If the flash memory hasent been initalised, set with
  //default values ready for configuration.
  if(!strcmp(customVar.initialised, "YES")){
    strcpy(customVar.initialised,"YES");
    strcpy(customVar.ssid, "");
    strcpy(customVar.password, "");
    customVar.clientId = 0;
    customVar.callWifiManager = true; 
    EEPROM.put(0, customVar);
    EEPROM.commit();
  };

  //resetButton.attachClick(resetMatrixClick);
  resetButton.attachLongPressStop(resetWifiClick);
  resetMatrixButton.attachClick(resetMatrixClick);

 
  String tmp_uid = WiFi.macAddress();
  tmp_uid.replace(":", "");      // Remove colons
  tmp_uid = "a4l-" + tmp_uid;    // Prepend "a4l-"
  strcat(uid, tmp_uid.c_str());
  Serial.println(uid);

  pinMode(VIBRATION_SENSOR_GPIO, INPUT);
  pinMode(RESET_GPIO, INPUT_PULLUP);
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN,HIGH);
  delay(1000);
  digitalWrite(LED_PIN,LOW);


  for(int period = 0; period < 4; period ++){
    pinMode(periodPort[period], OUTPUT);
    digitalWrite(periodPort[period], LOW);
    for (int day = 0; day < 7; day++){
      pinMode(dayPort[day], INPUT);
    }
  }
 ////strcpy(customVar.ssid, "stratton_bt2");
  //customVar.callWifiManager = true;
  if(utilities.isAllBlank(customVar.ssid) || customVar.callWifiManager){
    currentState = CONFIG_WIFI;
  }else{
    currentState = CONNECT_WIFI;
  }
  initalise();
  scanSwitchMatrix();
  scanSwitchMatrixTest();

  pinMode(HOME_GPIO, INPUT_PULLUP);


  stepper.setMaxSpeed(40);        // slightly above target
  stepper.setAcceleration(20);    // smooth start/stop
  //stepper.setMaxSpeed(1000);
  //stepper.setSpeed(50);	
  
}

