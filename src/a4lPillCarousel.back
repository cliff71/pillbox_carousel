void setBLESmartConfig(){
  String deviceName = "a4l-";
  deviceName += deviceInfo.type_short;
  bleConfig.begin(deviceName.c_str());
  bleConfig.setServiceUUID("12345678-1234-5678-1234-56789abcdef0");
  bleConfig.setCharacteristicUUID("abcdef01-1234-5678-1234-56789abcdef1");
  bleConfig.setJsonCallback(handleJson);
}

int readBatteryPower(){
  float totalRawValue = 0;
  for (int x = 0; x < 10; x++){
    totalRawValue += analogRead(BATTERY_DATA_GPIO);
    delay(100);
  }
  float raw = totalRawValue / 10;
  Serial.print("Raw :");
  Serial.println(raw);
  float volts = raw * (3.3 / 4095);
  Serial.print("Volts :");
  Serial.println(volts);           //Volts Low  High
  float batteryVoltage =  mapfloat(volts, 1.88, 2.81, 2.9, 4.00);
  Serial.println(batteryVoltage);

  int percentage = (batteryVoltage - MIN_BATTERY_VOLTAGE) * 100 / (MAX_BATTERY_VOLTAGE - MIN_BATTERY_VOLTAGE);
  return constrain(percentage, 0, 100); // Ensure it's between 0 and 100

}
float mapfloat(float x, float in_min, float in_max, float out_min, float out_max){
  return (x - in_min) * (out_max - out_min) / (in_max - in_min) + out_min;
}